# Copy this file to ".env" and fill in your values

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notesapp?retryWrites=true&w=majority

# Secret used to sign JWT tokens - any long random string
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts
JWT_EXPIRES_IN=7d

# Port for the Express server
PORT=5000
